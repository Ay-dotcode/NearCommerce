{
  "expo": {
    "name": "Near Commerce",
    "slug": "nearcommerce",
    "version": "1.0.2",
    "scheme": "nearcommerce",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nearcommerce.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.nearcommerce.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#2563EB"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Near Commerce uses your location to show shops near you."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563EB"
        }
      ],
      "expo-live-activity",
      [
        "@use-voltra/android-client",
        {
          "enableNotifications": true
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "946855c9-19fa-411d-ba20-9010c1c9265f"
      }
    },
    "owner": "ay-dotecode",
    "updates": {
      "url": "https://u.expo.dev/946855c9-19fa-411d-ba20-9010c1c9265f"
    }
  }
}
