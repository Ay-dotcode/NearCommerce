# ==========================================
# NearCommerce Environment Variables Template
# ==========================================

# --- Backend API Setup ---
PORT=4000
NODE_ENV=development

# --- Database & Cache ---
# PostgreSQL Connection URL (e.g., Neon serverless Postgres)
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# Redis Connection URL (e.g., Upstash for Pub/Sub & Session checks)
REDIS_URL="rediss://default:password@host:port"

# --- Security & Auth ---
# Standard JWT secret for signing access and refresh tokens
JWT_SECRET="your_super_secret_jwt_key_here"

# --- Third-Party Services ---
# Google Gemini API (AI Search embeddings & text fallback)
GEMINI_API_KEY="your_gemini_api_key_here"

# SMTP / Email Provider (For sending verification & reset emails)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your_smtp_password"
EMAIL_FROM="noreply@nearcommerce.local"
