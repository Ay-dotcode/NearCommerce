# ==========================================
# NearCommerce Environment Variables Template
# ==========================================

# --- Backend API Setup ---
PORT=4000
NODE_ENV=development

# --- Database ---
# PostgreSQL Connection URL (e.g., Neon serverless Postgres)
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# --- Redis Cache (Upstash) ---
# Standard TCP connection (Required for Socket.io adapter & Redis client)
REDIS_URL="rediss://default:your_password@your-upstash-url.upstash.io:6379"

# --- Security & Auth ---
# JWT secrets for signing access and refresh tokens
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"

# --- Third-Party Services ---
# Google Gemini API (AI Search embeddings & text fallback)
# Optional: without a key the API skips embeddings and search falls back to text matching.
GEMINI_API_KEY="your_gemini_api_key_here"
# Optional: embedding model override (default: gemini-embedding-001)
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# SMTP / Email Provider (password-reset emails)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your_smtp_password"
EMAIL_FROM="noreply@nearcommerce.local"

# Public URL of the store-owner portal, used to build the links in emails (default: http://localhost:3001)
FRONTEND_URL="http://localhost:3001"

# --- Frontend & Mobile Client Configuration ---
# API base URL for the web portals (apps/web, apps/admin)
VITE_API_URL="http://localhost:4000"

# API base URL for the mobile app. Expo reads this from apps/mobile/.env, not this file.
# On a physical device use your computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL="http://localhost:4000"

# --- Database seeding (apps/backend: pnpm seed) ---
# seeds refuse to run unless you provide your own credentials here.
# SEED_ADMIN_EMAIL="admin@your-domain.com"
# SEED_ADMIN_PASSWORD="a-long-random-password"
# SEED_OWNER_EMAIL="owner@your-domain.com"
# SEED_OWNER_PASSWORD="a-long-random-password"
