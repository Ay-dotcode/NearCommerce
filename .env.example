# ==========================================
# NearCommerce Environment Variables Template
# ==========================================

# --- Backend API Setup ---
PORT=4000
NODE_ENV=development

# --- Database ---
# PostgreSQL Connection URL (e.g., Neon serverless Postgres)
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"
DATABASE_URL_POOLED="postgresql://user:password@host-pooler:port/dbname?sslmode=require"

# --- Redis Cache (Upstash) ---
# Standard TCP connection (Required for Socket.io adapter & Redis client)
REDIS_URL="rediss://default:your_password@your-upstash-url.upstash.io:6379"

# REST API connection (For quick stateless cache queries)
UPSTASH_REDIS_REST_URL="https://your-upstash-rest-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# --- Security & Auth ---
# JWT secrets for signing access and refresh tokens
JWT_SECRET="your_super_secret_jwt_key_here"
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"

# --- Third-Party Services ---
# Google Gemini API (AI Search embeddings & text fallback)
# Model used: text-embedding-004
GEMINI_API_KEY="your_gemini_api_key_here"

# SMTP / Email Provider (For sending verification & reset emails)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your_smtp_password"
EMAIL_FROM="noreply@nearcommerce.local"

# --- Frontend & Mobile Client Configuration ---
# API base URL for Web Apps (apps/web, apps/admin, @nearcommerce/api)
VITE_API_URL="http://localhost:4000"

# API & Auth for Mobile App (apps/mobile Expo)
EXPO_PUBLIC_API_URL="http://localhost:4000"
EXPO_PUBLIC_ACCESS_TOKEN=""
